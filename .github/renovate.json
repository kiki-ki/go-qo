{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>kiki-ki/renovate-config"],
  "packageRules": [
    {
      "description": "CI uses this Go version; raising it is safe because nothing imports this module.",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
